// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                  String              @id @default(cuid())
  email               String?             @unique
  name                String?
  image               String?
  password            String?             @db.Text // Hashed password for credentials auth
  emailVerified       DateTime?
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
  accounts            Account[]
  sessions            Session[]
  profile             Profile?
  agentSessions       AgentSession[]
  achievements        UserAchievement[]
  content             Content[]
  progress            UserProgress[]
  trainingLogs        TrainingLog[]
  financialData       FinancialData[]
  activities          UserActivity[]
  insightsHistory     InsightsHistory[]
  qaProjects          QaProject[]
  qaQuestionsEdited   QaQuestion[]        @relation("QaQuestionEditor")
  qaQuestionsRated    QaQuestion[]        @relation("QaQuestionRater")
  qaAnswersEdited     QaAnswer[]          @relation("QaAnswerEditor")
  qaAnswersRated      QaAnswer[]          @relation("QaAnswerRater")
  contentPrompts      ContentPrompt[]
  contentGuidelines   ContentGuideline[]
  corpusFiles         CorpusFile[]
  contentAuditLogs    ContentAuditLog[]
  seguePillResearches SeguePillResearch[]
  segueCampaignGoals  SegueCampaignGoal[]
  segueTestSessions   SegueTestSession[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Profile {
  id                 String   @id @default(cuid())
  userId             String   @unique
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  age                Int?
  location           String?
  interests          String[] // Career interests, skills
  fitnessLevel       String? // beginner, intermediate, advanced
  mentalHealth       String? // self-reported level
  careerGoals        Json? // Structured career path preferences
  preferences        Json? // User preferences for recommendations
  onboardingComplete Boolean  @default(false)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

// Agent Sessions - track interactions with AI agents
model AgentSession {
  id          String   @id @default(cuid())
  userId      String?
  user        User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  agentType   String // recruitment, training, financial, educational
  sessionData Json // Conversation history, context
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// Gamification - Achievements
model Achievement {
  id          String            @id @default(cuid())
  name        String
  description String
  icon        String?
  points      Int               @default(0)
  category    String // training, career, community, learning
  users       UserAchievement[]
  createdAt   DateTime          @default(now())
}

model UserAchievement {
  id            String      @id @default(cuid())
  userId        String
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  achievementId String
  achievement   Achievement @relation(fields: [achievementId], references: [id], onDelete: Cascade)
  unlockedAt    DateTime    @default(now())

  @@unique([userId, achievementId])
}

// User-generated content
model Content {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type        String // guide, review, tip, story
  title       String
  description String?
  body        String   @db.Text
  tags        String[]
  approved    Boolean  @default(false)
  views       Int      @default(0)
  likes       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// Training and Progress Tracking
model TrainingLog {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String // physical, mental
  activity  String
  duration  Int? // minutes
  intensity String? // low, medium, high
  notes     String?  @db.Text
  completed Boolean  @default(true)
  createdAt DateTime @default(now())
}

model UserProgress {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  category   String // career, physical, mental, financial, education
  progress   Json // Structured progress data
  level      Int      @default(1)
  experience Int      @default(0)
  updatedAt  DateTime @updatedAt

  @@unique([userId, category])
}

// Financial Data (for financial assistant agent)
model FinancialData {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String // goal, budget, benefit, question
  data      Json // Structured financial information
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// User Activity Tracking - navigation, interactions, usage patterns
model UserActivity {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String // agent_interaction, page_view, action, navigation
  agentType String? // recruitment, training, financial, educational
  page      String? // page path
  action    String? // action identifier
  metadata  Json? // Additional context data
  createdAt DateTime @default(now())

  @@index([userId, type])
  @@index([userId, agentType])
  @@index([createdAt])
}

// Insights History - track insights changes over time
model InsightsHistory {
  id                String   @id @default(cuid())
  userId            String
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  engagementLevel   String? // low, medium, high, very_high
  engagementScore   Int? // 0-100
  experienceTotal   Int? // Total experience points
  sentimentLabel    String? // very_negative, negative, neutral, positive, very_positive
  sentimentScore    Float? // -1 to 1
  preferences       Json? // Array of preferences
  personalityTraits Json? // Array of personality traits
  insightsSnapshot  Json // Full insights snapshot at this point in time
  createdAt         DateTime @default(now())

  @@index([userId, createdAt])
  @@index([createdAt])
}

// Content Tool - Projects
model QaProject {
  id                  String    @id @default(cuid())
  name                String
  description         String?
  status              String    @default("draft") // draft, in_progress, review, published, archived
  targetQuestionCount Int       @default(250)
  publishedCount      Int       @default(0)
  corpusFileId        String?
  questionPromptId    String?
  answerPromptId      String?
  guidelineId         String?
  createdById         String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  archivedAt          DateTime?

  corpusFile     CorpusFile?       @relation(fields: [corpusFileId], references: [id])
  questionPrompt ContentPrompt?    @relation("QuestionPrompt", fields: [questionPromptId], references: [id])
  answerPrompt   ContentPrompt?    @relation("AnswerPrompt", fields: [answerPromptId], references: [id])
  guideline      ContentGuideline? @relation(fields: [guidelineId], references: [id])
  createdBy      User?             @relation(fields: [createdById], references: [id], onDelete: SetNull)
  questions      QaQuestion[]
  sourcePages    KnowledgeSourcePage[]
  batchJobs      ContentBatchJob[]
  auditLogs      ContentAuditLog[]
  pillResearches SeguePillResearch[]

  @@index([status])
  @@index([createdAt])
}

model QaQuestion {
  id                   String    @id @default(cuid())
  projectId            String
  topic                String
  persona              String?
  tone                 String?
  questionText         String    @db.Text
  sourceUrls           String[]
  status               String    @default("draft") // draft, pending, approved, rejected, published, valid, needs_review, invalid
  batchNumber          Int?
  createdFromGenerator Boolean   @default(true)
  editedById           String?
  editedAt             DateTime?
  corpusValidated      Boolean   @default(false)
  validationNotes      String?
  ratingDefault        Int       @default(3)
  ratingValue          Int       @default(3)
  ratingUpdatedById    String?
  ratingUpdatedAt      DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  project         QaProject         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  answers         QaAnswer[]
  editedBy        User?             @relation("QaQuestionEditor", fields: [editedById], references: [id], onDelete: SetNull)
  ratingUpdatedBy User?             @relation("QaQuestionRater", fields: [ratingUpdatedById], references: [id], onDelete: SetNull)
  auditLogs       ContentAuditLog[]

  @@index([projectId])
  @@index([status])
  @@index([batchNumber])
}

model QaAnswer {
  id                String    @id @default(cuid())
  questionId        String
  variantLevel      String // very_direct, direct, somewhat_direct, indirect
  answerText        String    @db.Text
  characterCount    Int?
  keywords          String[]
  sourceLink        String?
  validationStatus  String    @default("pending") // draft, pending, approved, rejected, published, valid, needs_review, invalid
  validationNotes   String?
  editedById        String?
  editedAt          DateTime?
  ratingDefault     Int       @default(3)
  ratingValue       Int       @default(3)
  ratingUpdatedById String?
  ratingUpdatedAt   DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  question        QaQuestion        @relation(fields: [questionId], references: [id], onDelete: Cascade)
  editedBy        User?             @relation("QaAnswerEditor", fields: [editedById], references: [id], onDelete: SetNull)
  ratingUpdatedBy User?             @relation("QaAnswerRater", fields: [ratingUpdatedById], references: [id], onDelete: SetNull)
  mediaAssets     QaAnswerMedia[]
  auditLogs       ContentAuditLog[]

  @@index([questionId])
  @@index([validationStatus])
}

model KnowledgeSourcePage {
  id          String   @id @default(cuid())
  projectId   String?
  externalUrl String
  title       String?
  slug        String?
  section     String?
  status      String   @default("discovered") // discovered, crawled, processed, indexed, archived
  rawHtml     String?  @db.Text
  textContent String?  @db.Text
  checksum    String?
  scrapedAt   DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  project     QaProject?             @relation(fields: [projectId], references: [id], onDelete: SetNull)
  chunks      KnowledgeSourceChunk[]
  mediaAssets KnowledgeSourceMedia[]

  @@index([projectId])
  @@index([section])
  @@index([status])
  @@index([externalUrl])
}

model KnowledgeSourceChunk {
  id            String   @id @default(cuid())
  pageId        String
  chunkIndex    Int
  heading       String?
  content       String   @db.Text
  tokenCount    Int?
  embeddingJson Json?
  metadata      Json?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  page KnowledgeSourcePage @relation(fields: [pageId], references: [id], onDelete: Cascade)

  @@unique([pageId, chunkIndex])
  @@index([pageId])
}

model KnowledgeSourceMedia {
  id           String   @id @default(cuid())
  pageId        String
  mediaType     String // image, youtube, chart_json, embed, file
  sourceUrl     String
  title         String?
  description   String?
  thumbnailUrl  String?
  provider      String?
  data          Json?
  sortOrder     Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  page KnowledgeSourcePage @relation(fields: [pageId], references: [id], onDelete: Cascade)

  @@index([pageId])
  @@index([mediaType])
}

model QaAnswerMedia {
  id           String   @id @default(cuid())
  answerId     String
  mediaType    String // image, youtube, chart, chart_json
  sourceUrl    String
  title        String?
  description  String?
  thumbnailUrl String?
  provider     String?
  data         Json?
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  answer QaAnswer @relation(fields: [answerId], references: [id], onDelete: Cascade)

  @@index([answerId])
  @@index([mediaType])
}

model CorpusFile {
  id          String   @id @default(cuid())
  name        String
  fileContent String   @db.Text
  fileHash    String?
  sourceUrls  String[]
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  isActive    Boolean  @default(true)

  createdBy User?       @relation(fields: [createdById], references: [id], onDelete: SetNull)
  projects  QaProject[]

  @@index([isActive])
}

model ContentPrompt {
  id          String   @id @default(cuid())
  name        String
  type        String // question_generator, answer_generator
  content     String   @db.Text
  version     String
  isActive    Boolean  @default(false)
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  createdBy              User?       @relation(fields: [createdById], references: [id], onDelete: SetNull)
  questionPromptProjects QaProject[] @relation("QuestionPrompt")
  answerPromptProjects   QaProject[] @relation("AnswerPrompt")

  @@index([type])
  @@index([isActive])
}

model ContentGuideline {
  id          String   @id @default(cuid())
  name        String
  content     String   @db.Text
  version     String
  isActive    Boolean  @default(false)
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  createdBy User?       @relation(fields: [createdById], references: [id], onDelete: SetNull)
  projects  QaProject[]

  @@index([isActive])
}

model ContentBatchJob {
  id               String    @id @default(cuid())
  projectId        String
  batchNumber      Int
  questionsInBatch Int?
  status           String    @default("pending") // pending, processing, completed, failed
  promptType       String // question_generator, answer_generator
  apiResponse      Json?
  errorMessage     String?
  startedAt        DateTime?
  completedAt      DateTime?
  createdAt        DateTime  @default(now())

  project QaProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, batchNumber, promptType])
  @@index([projectId])
  @@index([status])
}

model ContentAuditLog {
  id          String   @id @default(cuid())
  projectId   String?
  questionId  String?
  answerId    String?
  actionType  String
  oldValue    Json?
  newValue    Json?
  changedById String?
  changedAt   DateTime @default(now())

  project   QaProject?  @relation(fields: [projectId], references: [id], onDelete: SetNull)
  question  QaQuestion? @relation(fields: [questionId], references: [id], onDelete: SetNull)
  answer    QaAnswer?   @relation(fields: [answerId], references: [id], onDelete: SetNull)
  changedBy User?       @relation(fields: [changedById], references: [id], onDelete: SetNull)

  @@index([projectId])
  @@index([changedAt])
}

// Segue Pills Research Lab - Campaign Goals
model SegueCampaignGoal {
  id             String   @id @default(cuid())
  name           String
  goalType       String // recruiter_contact, assessment, event_registration, custom
  description    String?
  businessPrompt String   @db.Text // Appended to pill generation prompts
  ctaRequirement Json // { minCount, maxCount, requiredPills: [] }
  isActive       Boolean  @default(true)
  createdById    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  createdBy  User?               @relation(fields: [createdById], references: [id], onDelete: SetNull)
  researches SeguePillResearch[]

  @@index([isActive])
  @@index([goalType])
}

// Segue Pills Research Lab - Research Projects
model SeguePillResearch {
  id          String  @id @default(cuid())
  name        String
  description String?
  status      String  @default("draft") // draft, generating, testing, completed, archived

  // Generation parameters
  personas      String[] // high_school, career_changer, veteran_family, college_student
  topics        String[] // eligibility, careers, benefits, training, join_process
  questionCount Int      @default(100)

  // Generated data
  syntheticQuestions Json? // Array of { id, question, intent, persona, context }
  scrapedQuestions   Json? // Array of scraped questions (optional)
  scrapedUrls        String[] // URLs that were scraped
  intentClusters     Json? // Array of { intent, questions: [], pillCandidates: [] }
  pillLibrary        Json? // Array of { id, label, intent, type, confidence, useCase }

  // Campaign goal
  campaignGoalId String?
  campaignGoal   SegueCampaignGoal? @relation(fields: [campaignGoalId], references: [id], onDelete: SetNull)

  // Linked Q&A Project
  qaProjectId String?
  qaProject   QaProject? @relation(fields: [qaProjectId], references: [id], onDelete: SetNull)

  // Test results
  testSessions SegueTestSession[]

  // Final output
  recommendations Json? // { case1: [], case2: [], case3: [] } with scores

  createdById String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  archivedAt  DateTime?

  createdBy User? @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([createdAt])
}

// Segue Pills Research Lab - Test Sessions
model SegueTestSession {
  id         String            @id @default(cuid())
  researchId String
  research   SeguePillResearch @relation(fields: [researchId], references: [id], onDelete: Cascade)

  // Test scenario
  testCase        Int // 1, 2, or 3
  scenarioContext Json? // { page, topic, sentiment, engagement } for Cases 2 & 3

  // Pills shown
  pillsShown Json // Array of { id, label, type }

  // User interaction
  clickedPillId    String?
  clickedPillLabel String?
  clickOrder       Int? // Which pill they clicked (1-4)
  timeToClick      Int? // Seconds until click

  // Feedback
  rating         Int? // 1-5 stars
  relevanceScore Int? // 1-5 for relevance
  clarityScore   Int? // 1-5 for clarity
  feedback       String? @db.Text

  // Chat outcome (if they continued)
  chatCompleted Boolean @default(false)
  reachedCta    Boolean @default(false)
  ctaType       String? // recruiter_contact, assessment, etc.

  testerId String?
  tester   User?   @relation(fields: [testerId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([researchId])
  @@index([testCase])
  @@index([createdAt])
}
